	$(MAKE) $(MAKESILENT) -f CMakeFiles/services.dir/build.make CMakeFiles/services.dir/src/services/PrimeService.cpp.i
.PHONY : src/services/PrimeService.cpp.i

src/services/PrimeService.s: src/services/PrimeService.cpp.s
.PHONY : src/services/PrimeService.s

# target to generate assembly for a file
